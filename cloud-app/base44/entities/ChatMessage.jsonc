{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "system"
      ]
    },
    "content": {
      "type": "string"
    },
    "fix_proposal": {
      "type": "string"
    },
    "fix_status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "rejected",
        "applied",
        "reverted"
      ],
      "default": "pending"
    }
  },
  "required": [
    "session_id",
    "role",
    "content"
  ]
}