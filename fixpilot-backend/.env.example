# Provided automatically by Railway when you add a Postgres service —
# just reference it as ${{Postgres.DATABASE_URL}} in your Railway service
# variables, or paste the value directly for local dev.
DATABASE_URL=postgresql://user:password@localhost:5432/fixpilot

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# Comma-separated list of origins allowed to call this API with credentials
# (your Railway/Vercel-hosted dashboard URL, http://localhost:5173 for dev)
DASHBOARD_ORIGIN=http://localhost:5173

# Stripe (used by the checkout/webhook routes once ported)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

PORT=8080
NODE_ENV=development
